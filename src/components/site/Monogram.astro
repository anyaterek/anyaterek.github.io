---
/**
 * Monogram: lowercase a and t drawn as one wire.
 * a: bowl and stem → wire along the baseline → t stem up. The t crossbar is a short tap ending in a terminal node.
 * Same drawing as public/favicon.svg.
 */
---

<svg class="monogram" viewBox="0 0 32 32" aria-hidden="true" focusable="false">
  <path
    d="M15 13V18A5 5 0 0 0 5 18A5 5 0 0 0 15 18V23Q15 25 17 25H19Q21 25 21 23V7M17 12H24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"></path>
  <circle cx="25.5" cy="12" r="2" fill="currentColor"></circle>
</svg>

<style>
  .monogram {
    width: var(--mono-size);
    height: var(--mono-size);
  }
</style>
